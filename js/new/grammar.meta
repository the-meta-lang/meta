//  @author Letsmoe
//  @email moritz.utcke@gmx.de
//  @create date 2024-09-25 16:14:01
//  @modify date 2024-09-25 16:14:01
//  @desc The syntax definition of the META Compiler writing language.
//  - pflag: Indicates if the last parse rule succeeded.
//  - eflag: Indicates if the last parse rule encountered an error.
.SYNTAX PROGRAM

// body of compiler definition 
PROGRAM = $(
	(ENTRY_RULE PREAMBLE)
	| PARSE_RULE
	| TOKEN_RULE
	| IGNORE_RULE
	| COMMENT
);

ENTRY_RULE = "entry" ID ";";

IGNORE_RULE = "ignore" TX1 ";";

// object definition preamble 
PREAMBLE = 
	->("let pflag = false;" .NL)
	->("let tflag = false;" .NL)
	->("let eflag = false;" .NL)
	->("let inbuf = " 34 34 ";" .NL)
	->("let outbuf = " 34 34 ";" .NL)
	->("let match: string = " 34 34 ";" .NL)
	->("let cursor: number = 0;" .NL)
	->("let erule = " 34 34 ";" .NL)
	->("let einput = 0;" .NL)
	->("let labelcount = 0;" .NL)
	->("let stackframesize = 6;" .NL)
	->("let stackframe = 0;" .NL)
	->("let stos = -1;" .NL)
	->("let parsetree = { type: " 34 34 ", children: [] };" .NL)
	->("let __TREE__ = parsetree;" .NL)
	->("let stack: any[] = [];" .NL)

	->("function initialize() {" .NL)
	->("	// initialize for another compile" .NL)
	->("	pflag = false;" .NL)
	->("	tflag = false;" .NL)
	->("	eflag = false;" .NL)
	->("	outbuf = " 34 34 ";" .NL)
	->("	erule = " 34 34 ";" .NL)
	->("	einput = 0;" .NL)
	->("	parsetree = { type: " 34 "Program" 34 ", children: [] };" .NL)
	->("	__TREE__ = parsetree;" .NL)
	->("	labelcount = 1;" .NL)
	->("	stackframe = -1;" .NL)
	->("	stos = -1;" .NL)
	->("	stack = [];" .NL)
	->("}" .NL)

	->("function ctxpush(rulename: string) {" .NL)
	->("	// push and initialize a new stackframe" .NL)
	->("	var LM;" .NL)
	->("	// new context inherits current context left margin" .NL)
	->("	LM = 0;" .NL)
	->("	if (stackframe >= 0) LM = stack[stackframe + 2];" .NL)
	->("	stos++;" .NL)
	->("	stackframe = stos * stackframesize;" .NL)
	->("	// stackframe definition" .NL)
	->("	stack[stackframe + 0] = 0; // generated label" .NL)
	->("	stack[stackframe + 1] = rulename; // called rule name" .NL)
	->("	stack[stackframe + 2] = LM; // left margin" .NL)
	->("	stack[stackframe + 3] = cursor; // left margin" .NL)
	->("	// clear additional stackframe backtracking entries" .NL)
	->("	bkclear();" .NL)
	->("}" .NL)

	->("function ctxpop() {" .NL)
	->("	// pop and possibly deallocate old stackframe" .NL)
	->("	stos--; // pop stackframe" .NL)
	->("	stackframe = stos * stackframesize;" .NL)
	->("}" .NL)

	->("function out(s: string) {" .NL)
	->("	// output string" .NL)
	->("	var i;" .NL)
	->("	// if newline last output, add left margin before string" .NL)
	->("	if (outbuf.charAt(outbuf.length - 1) == " 34 92 "n" 34 ") {" .NL)
	->("		i = stack[stackframe + 2];" .NL)
	->("		while (i > 0) {" .NL)
	->("			outbuf += " 34 " " 34 ";" .NL)
	->("			i--;" .NL)
	->("		}" .NL)
	->("	}" .NL)
	->("	outbuf += s;" .NL)
	->("}" .NL)

	->("function eol() {" .NL)
	->("	// output end of line" .NL)
	->("	outbuf += " 34 92 "n" 34 ";" .NL)
	->("}" .NL)

	->("function test(s: string) {" .NL)
	->("	// test for a string in the input" .NL)
	->("	var i;" .NL)
	->("	// delete whitespace" .NL)
	->("	while (" .NL)
	->("		inbuf.charAt(cursor) == " 34 " " 34 " ||" .NL)
	->("		inbuf.charAt(cursor) == " 34 92 "n" 34 " ||" .NL)
	->("		inbuf.charAt(cursor) == " 34 92 "r" 34 " ||" .NL)
	->("		inbuf.charAt(cursor) == " 34 92 "t" 34 "" .NL)
	->("	)" .NL)
	->("		cursor++;" .NL)
	->("	// test string case insensitive" .NL)
	->("	pflag = true;" .NL)
	->("	i = 0;" .NL)
	->("	while (pflag && i < s.length && cursor + i < inbuf.length) {" .NL)
	->("		pflag =" .NL)
	->("			s.charAt(i).toUpperCase() ==" .NL)
	->("			inbuf.charAt(cursor + i).toUpperCase();" .NL)
	->("		i++;" .NL)
	->("	}" .NL)
	->("	pflag = pflag && i == s.length;" .NL)
	->("	// advance input if found" .NL)
	->("	if (pflag) cursor += s.length;" .NL)
	->("}" .NL)

	->("function bkerr() {" .NL)
	->("	// compilation error, provide error indication and context" .NL)
	->("	eflag = true;" .NL)
	->("	erule = stack[stackframe + 1];" .NL)
	->("	einput = cursor;" .NL)
	->("}" .NL)

	->("function bkset() {" .NL)
	->("	// set backtrack context on stack" .NL)
	->("	stack[stackframe + 4] = cursor; // input position" .NL)
	->("	stack[stackframe + 5] = outbuf.length; // output position" .NL)
	->("	stack[stackframe + 6] = match; // current token" .NL)
	->("}" .NL)

	->("function bkclear() {" .NL)
	->("	// clear backtrack context on stack" .NL)
	->("	stack[stackframe + 4] = -1; // input position" .NL)
	->("	stack[stackframe + 5] = -1; // output position" .NL)
	->("	stack[stackframe + 6] = " 34 34 "; // current token" .NL)
	->("}" .NL)

	->("function bkrestore() {" .NL)
	->("	// restore context for backtracking" .NL)
	->("	eflag = false;" .NL)
	->("	cursor = stack[stackframe + 4]; // input position" .NL)
	->("	outbuf = outbuf.substring(0, stack[stackframe + 5]); // output position" .NL)
	->("	match = stack[stackframe + 6]; // current token" .NL)
	->("}" .NL)

	->("export function compile(input: string) {" .LM+ .NL)
	->("// initialize compiler variables" .NL)
	->("inbuf = input;" .NL)
	->("initialize() ;" .NL)
	->("// call the first rule" .NL)
	->("ctxpush(" 34 * 34 ") ;" .NL)
	->("let _ = $" * "() ;" .NL)
	->("ctxpop() ;" .NL)
	->("// special case handling of first rule failure" .NL)
	->("if ((!eflag) && (!_.ok)) {" .LM+ .NL)
	->("eflag = true ;" .NL)
	->("erule = " 34 * 34 ";};" .LM- .NL)
	->("return { outbuf, eflag, inp: cursor, erule, stack, inbuf, parsetree };" .NL)
	->(.LM- "}" .NL .NL);

// parsing rule definition 
// @example PARSE_RULE<argument, argument2>
PARSE_RULE = "rule" ID ->("const $" * ": RuleFunction = function") (
	("(" ->("(this: Context,") PARSE_RULE_ARGUMENT_DEFINITION_LIST ")" ->(")"))
	| (.EMPTY ->("(this: Context)"))
	)
	->("{" .LM+ .NL)
	->("let _: Match;" .NL)
	"=" EX1 ";"
	->("return { ok: _.ok }" .NL)
	->(.LM- "}" .NL .NL) ;

// token rule definition 
TOKEN_RULE = "token" ID ->("function $"* "() {" .LM+ .NL)
		->("let value: string = '';" .NL)
		->("let ok: boolean = true;" .NL)
     "=" TX1 ";"
		 ->("return { ok, value };" .NL)
     ->(.LM- "}" .NL .NL) ;

// comment definition
COMMENT = "//" CMLINE ->("//" * .NL) ;

// --------------------------- Parsing expressions -----------------------------
EX1 = EX2 $("|" ->("if ((!pflag) && (!eflag)) {" .LM+ .NL)
                EX2
                ->(.LM- "} ;" .NL) ) ;

EX2 = (EX3 ->("if (pflag) {" .LM+ .NL)
				| OUTPUT ->("if (true) {" .LM+ .NL))
			->("while (!eflag) {" .LM+ .NL)
      $(EX3 ->("if (!pflag) bkerr();" .NL)
            ->("if (eflag) break ;" .NL)
				| OUTPUT)
      ->("break }" .LM- .NL)
      ->(.LM- "} ;" .NL);

EX3 = ID
				->("ctxpush(" 34 * 34 ") ;" .NL)
				->("_ = $" * "(") (("{" PARSE_RULE_ARGUMENT_LIST "}") | .EMPTY) ->(");" .NL)
				->("ctxpop() ;" .NL)
		| STRING    ->("_ = test(" 34 * 34 ");" .NL)
		| "(" EX1 ")"                            
		| ".EMPTY"  ->("pflag = true ;" .NL)
		| ".LITCHR"
				->("match = inbuf.charCodeAt(cursor) ;" .NL)
				->("cursor++ ;" .NL)
		| ".PASS"   ->("cursor = 0 ;" .NL)
		| "$" ->("pflag = true ;" .NL)
          ->("while (pflag && !eflag) {" .LM+ .NL)
          EX3 
          ->(.LM- "} ;" .NL)
          ->("pflag = !eflag ;" .NL)
		| "{" ->("bkset() ;" .NL) EX1
        $("/" ->("if (!pflag) {" .LM+ .NL)
							->("if (eflag) bkrestore() ;" .NL)
                EX1
              ->(.LM- "} ;" .NL))
      "}" ->("if (eflag) bkrestore() ;" .NL)
          ->("bkclear() ;" .NL)
		| COMMENT;

// ------------------------- Parsing Rule Arguments ----------------------------

PARSE_RULE_ARGUMENT_LIST = PARSE_RULE_ARGUMENT ->(*) $(PARSE_RULE_ARGUMENT ->(", " *));

PARSE_RULE_ARGUMENT = (ID | RAWSTRING | NUMBER);

// Matches an argument passed to a match rule as a parameter.
PARSE_RULE_ARGUMENT_DEFINITION = ID ->(*) ((":" TYPE ->("/*" ":" * "*/")) | .EMPTY) (("=" (ID | RAWSTRING | NUMBER) ->(" = " *)) | .EMPTY);
PARSE_RULE_ARGUMENT_DEFINITION_LIST = PARSE_RULE_ARGUMENT_DEFINITION $(PARSE_RULE_ARGUMENT_DEFINITION);

// --------------------------- Output expressions ------------------------------
OUTPUT = "->" "(" $OUT1 ")" ;

OUT1 = "*" ((ID ->("out(" * ");" .NL)) | (.EMPTY ->("out(match) ;" .NL)))
			| STRING  ->("out(" 34 * 34 ") ;" .NL)
			| NUMBER  ->("out(String.fromCharCode(" * ")) ;" .NL)
			| ".NL"
				->("eol() ;" .NL)
			| ".TB"
				->("out(" 34 92 "t" 34 ") ;" .NL)          
			| ".LM+"
				->("stack[stackframe + 2] += 2 ;" .NL) 
			| ".LM-"
				->("stack[stackframe + 2] -= 2 ;" .NL);

// ---------------------------- Token expressions ------------------------------
TX1 = TX2 $("/" ->("if (!pflag) {" .LM+ .NL) TX2 ->(.LM- "} ;" .NL) ) ;

TX2 = TX3 ->("if (pflag) {" .LM+ .NL) 
      $(TX3 ->("if (!pflag) return;" .NL) ) 
      ->(.LM- "} ;" .NL) ;

TX3 = (".TOKEN"  ->("tflag = true ; " .NL)
			->("match = " 34 34 " ;" .NL)
		| ".DELTOK"
			->("tflag = false ;" .NL)
		| "$" ->("pflag = true ;" .NL)
			->("while (pflag) {" .LM+ .NL)
				TX3 
			->(.LM- "};" .NL))
			->("pflag = true ;" .NL)
		| ".ANYBUT(" CX1 ")" ->("pflag = !pflag ;" .NL) 
			->("if (pflag) {" .LM+ .NL)
			->("if (tflag) match += inbuf.charAt(cursor) ;" .NL)
			->("cursor++ } ;" .LM- .NL)
		| ".ANY(" CX1 ")" 
			->("if (pflag) {" .LM+ .NL)
			->("if (tflag) match += inbuf.charAt(cursor) ;" .NL)
			->("cursor++ } ;" .LM- .NL)
		| ID                 
			->("ctxpush(" 34 * 34 ") ;" .NL)
			->("$" * "() ;" .NL)
			->("ctxpop() ;" .NL)
			->("if (eflag) return ;" .NL)
		| "(" TX1 ")";

// -------------------------- Character expressions ----------------------------
CX1 = ->("pflag = " .LM+ .NL)
      CX2 $("!" ->(" ||" .NL) CX2)
      ->(.LM- " ;" .NL) ;
CX2 = CX3 (":" ->("((inbuf.charCodeAt(cursor) >= " * ") &&" .NL)
				CX3
					->(" (inbuf.charCodeAt(cursor) <= " * ")  )" )
				| .EMPTY ->("(inbuf.charCodeAt(cursor) == " * ") " ));
CX3 = NUMBER | SQUOTE .LITCHR ;

.TOKENS

PREFIX : $.ANY(32!9!13!10) ;
ID     : PREFIX .TOKEN ALPHA $(ALPHA/DIGIT) .DELTOK ;
NUMBER : PREFIX .TOKEN $.ANY('-) DIGIT $DIGIT .DELTOK ;
STRING : PREFIX .ANY(34) .TOKEN $.ANYBUT(13!10!34) .DELTOK .ANY(34) ;
RAWSTRING : PREFIX .TOKEN .ANY(34) $.ANYBUT(13!10!34) .ANY(34) .DELTOK;
ALPHA  : .ANY('A:'Z!'a:'z!'_) ;
DIGIT  : .ANY('0:'9) ;
SQUOTE : PREFIX .ANY('') ;
CMLINE : .TOKEN $.ANYBUT(10!13) .DELTOK ;

.END
