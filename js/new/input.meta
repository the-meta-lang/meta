//  @author Letsmoe
//  @email moritz.utcke@gmx.de
//  @create date 2024-09-25 16:14:01
//  @modify date 2024-09-25 16:14:01
//  @desc The syntax definition of the META Compiler writing language.
//  - pflag: Indicates if the last parse rule succeeded.
//  - eflag: Indicates if the last parse rule encountered an error.
.GRAMMAR PROGRAM

.INCLUDE("../../types.ts")

// body of compiler definition 
rule PROGRAM = $(
	".GRAMMAR" ID
		->("//" * " compiler" .NL)
		PREAMBLE
	| PARSE_RULE
	| TOKEN_RULE
	| INCLUDE_STATEMENT
	| COMMENT
);

// object definition preamble 
rule PREAMBLE = ->("export function compile(input: string) {" .LM+ .NL)
           ->("// initialize compiler variables" .NL)
           ->("inbuf = input;" .NL)
           ->("stdin = inbuf;" .NL)
           ->("initialize() ;" .NL)
           ->("// call the first rule" .NL)
           ->("ctxpush(" 34 * 34 ") ;" .NL)
           ->("rule" * "() ;" .NL)
           ->("ctxpop() ;" .NL)
           ->("// special case handling of first rule failure" .NL)
           ->("if ((!eflag) && (!pflag)) {" .LM+ .NL)
           ->("eflag = true ;" .NL)
           ->("erule = " 34 * 34 ";};" .LM- .NL)
           ->("return { outbuf, eflag, inp: __SCOPE__.__CURSOR__, erule, stack, inbuf, parsetree, __SCOPE__ };" .NL)
           ->(.LM- "}" .NL .NL);

// parsing rule definition 
// @example PARSE_RULE<argument, argument2>
rule PARSE_RULE = ID ->("function rule" *) (("<" ->("(") PARSE_RULE_ARGUMENT_DEFINITION_LIST ">" ->(")")) | (.EMPTY ->("()"))) ->("{" .LM+ .NL)
     "=" EX1 ";"
     ->(.LM- "}" .NL .NL) ;

// token rule definition 
rule TOKEN_RULE = ID ->("function rule"* "() {" .LM+ .NL)
     ":" TX1 ";"
     ->(.LM- "}" .NL .NL) ;

// comment definition 
rule COMMENT = "//" CMLINE ->("//" * .NL) ;

// -------------------------- Parse Tree Operators -----------------------------

// Captures a node for the current parse tree
// @example (ID :Identifier);
// @example @(ID :Identifier) ~ &scope :Block<id = &scope["__NODES__"][0]>[0];
rule CAPTURE_SINGLE_NODE = "::" ID
	->("__NODE__ = { type: " 34 * 34 ", start: stack[stackframe + 3], end: __SCOPE__.__CURSOR__, raw: __SCOPE__.__MATCH__,")
		(("<" FULL_ARGUMENT $("," FULL_ARGUMENT)) | .EMPTY)
	->("};" .NL)
	->("__STACK__.push(__NODE__);" .NL)
	->("__NODES__.push(__NODE__);" .NL);

rule CAPTURE_LAST_NODES = ":" ID
	->("combineParseTreeChildren(" 34 * 34 "," "{")
	(("<" FULL_ARGUMENT $("," FULL_ARGUMENT) ">") | .EMPTY)
	->("},") "[" NUMBER "]" ->(* ");" .NL);

rule FULL_ARGUMENT = ID ->(* ": ") "=" ARGUMENT ->(",");

rule ARGUMENT = (RAWSTRING | NUMBER | ID) ->(*)
	| ("**" "[" (NUMBER | ID) ->("__SCOPE__.__MATCHES__.at(" * ")") "]")
	| "@" (ID
		->(* ".toString()")
		| .EMPTY ->("outbuf.toString()"))
	| "&" ID (OBJECT_ACCESSOR $(OBJECT_ACCESSOR) | .EMPTY ->(*));

rule OBJECT_ACCESSOR = "::" (RAWSTRING | NUMBER | "&" ID) ->("[" * "]");

// --------------------------- Parsing expressions -----------------------------
rule EX1 = EX2 $("|" ->("if ((!pflag) && (!eflag)) {" .LM+ .NL)
                EX2
                ->(.LM- "} ;" .NL) ) ;

rule EX2 = (EX3 ->("if (pflag) {" .LM+ .NL)
				| OUTPUT ->("if (true) {" .LM+ .NL)
				| INCLUDE_STATEMENT
				| DIRECT_OUTPUT)
			->("while (!eflag) {" .LM+ .NL)
      $(EX3 ->("if (!pflag) bkerr();" .NL)
            ->("if (eflag) break ;" .NL)
				| OUTPUT
				| INCLUDE_STATEMENT
				| DIRECT_OUTPUT)
      ->("break }" .LM- .NL)
      ->(.LM- "} ;" .NL);

rule INCLUDE_STATEMENT = ".INCLUDE" "(" STRING ")"
	.DIRECT("out(fs.readFileSync(join(import.meta.dirname, " * "), 'utf-8'));");

rule DIRECT_OUTPUT = ".DIRECT" "(" $(
	STRING ->(*)
	| NUMBER ->(*)
	| ID ->(*)
	| "*" ->("__SCOPE__.__MATCH__")
) ")";

rule EX3 = ID
				->("ctxpush(" 34 * 34 ") ;" .NL)
				->("rule" * "(") (("<" PARSE_RULE_ARGUMENT_LIST ">") | .EMPTY) ->(");" .NL)
				->("ctxpop() ;" .NL)
		| STRING    ->("test(" 34 * 34 ");" .NL)
		| "(" EX1 ")"                            
		| ".EMPTY"  ->("pflag = true ;" .NL)
		| ".LITCHR"
				->("__SCOPE__.__MATCH__ = inbuf.charCodeAt(__SCOPE__.__CURSOR__) ;" .NL)
				->("__SCOPE__.__MATCHES__.push(__SCOPE__.__MATCH__);" .NL)
				->("__SCOPE__.__CURSOR__++ ;" .NL)
		| ".PASS"   ->("__SCOPE__.__CURSOR__ = 0 ;" .NL)
		| "$" ->("pflag = true ;" .NL)
          ->("while (pflag && !eflag) {" .LM+ .NL)
          EX3 
          ->(.LM- "} ;" .NL)
          ->("pflag = !eflag ;" .NL)
		| "{" ->("bkset() ;" .NL) EX1
        $("/" ->("if (!pflag) {" .LM+ .NL)
							->("if (eflag) bkrestore() ;" .NL)
                EX1
              ->(.LM- "} ;" .NL))
      "}" ->("if (eflag) bkrestore() ;" .NL)
          ->("bkclear() ;" .NL)
		| "*" ID ->("test(" * ");" .NL)
		| "?" ID ->("eflag = " * " ? false : true;" .NL)
		// Capture all following matches into a different buffer
		// If an ID is given immediately after, a named buffer is created
		| "@" ->("outbuf = new WriteBuffer();" .NL) "(" EX1 ")"
			// Store the buffer into the stack where it can be collected later.
			->("__STACK__.push(outbuf);" .NL)
			// Revert the output buffer back to the standard buffer
			->("outbuf = stdout;" .NL)
			
		// Collect the last value on the stack
		// @example @(ID) ~ &id
		| "~" ("&" ID ->(* " = __STACK__.pop();" .NL))
		| CAPTURE_SINGLE_NODE
		| CAPTURE_LAST_NODES
		| COMMENT;

// ------------------------- Parsing Rule Arguments ----------------------------

rule PARSE_RULE_ARGUMENT_LIST = PARSE_RULE_ARGUMENT ->(*) $(PARSE_RULE_ARGUMENT ->(", " *));

rule PARSE_RULE_ARGUMENT = (ID | RAWSTRING | NUMBER);

// Matches an argument passed to a match rule as a parameter.
rule PARSE_RULE_ARGUMENT_DEFINITION = ID ->(*) ((":" TYPE ->("/*" ":" * "*/")) | .EMPTY) (("=" (ID | RAWSTRING | NUMBER) ->(" = " *)) | .EMPTY);
rule PARSE_RULE_ARGUMENT_DEFINITION_LIST = PARSE_RULE_ARGUMENT_DEFINITION $(PARSE_RULE_ARGUMENT_DEFINITION);

// --------------------------- Output expressions ------------------------------
rule OUTPUT = "->" "(" $OUT1 ")" ;

rule OUT1 = "**" "[" (NUMBER | ID) ->("out(__SCOPE__.__MATCHES__.at(" * "));" .NL) "]"
			| "*" ((ID ->("out(" * ");" .NL)) | (.EMPTY ->("out(__SCOPE__.__MATCH__) ;" .NL)))
			| STRING  ->("out(" 34 * 34 ") ;" .NL)
			| NUMBER  ->("out(String.fromCharCode(" * ")) ;" .NL)
			| "#"
					->("if (stack[stackframe + 0] == 0) {" .LM+ .NL) 
					->("stack[stackframe + 0] = labelcount ;" .NL)
					->("labelcount++ ; } ;" .LM- .NL) 
					->("out(stack[stackframe + 0]) ;" .NL)
			| ".NL"
				->("eol() ;" .NL)
			| ".TB"
				->("out(" 34 92 "t" 34 ") ;" .NL)          
			| ".LM+"
				->("stack[stackframe + 2] += 2 ;" .NL) 
			| ".LM-"
				->("stack[stackframe + 2] -= 2 ;" .NL)
			| "@" (ID
					->("outbuf.write(" * ".toString());" .NL)
					| .EMPTY ->("outbuf.write(outbuf.toString());" .NL));

// ---------------------------- Token expressions ------------------------------
rule TX1 = TX2 $("|" ->("if (!pflag) {" .LM+ .NL) TX2 ->(.LM- "} ;" .NL) ) ;

rule TX2 = TX3 ->("if (pflag) {" .LM+ .NL) 
      $(TX3 ->("if (!pflag) return;" .NL) ) 
      ->(.LM- "} ;" .NL) ;

rule TX3 = (".TOKEN"  ->("tflag = true ; " .NL)
			->("__SCOPE__.__MATCH__ = " 34 34 " ;" .NL)
		| ".DELTOK"
			->("tflag = false ;" .NL)
			->("__SCOPE__.__MATCHES__.push(__SCOPE__.__MATCH__);" .NL)
		| "$" ->("pflag = true ;" .NL)
			->("while (pflag) {" .LM+ .NL)
				TX3 
			->(.LM- "};" .NL))
			->("pflag = true ;" .NL)
		| ".ANYBUT(" CX1 ")" ->("pflag = !pflag ;" .NL) 
			->("if (pflag) {" .LM+ .NL)
			->("if (tflag) __SCOPE__.__MATCH__ += inbuf.charAt(__SCOPE__.__CURSOR__) ;" .NL)
			->("__SCOPE__.__CURSOR__++ } ;" .LM- .NL)
		| ".ANY(" CX1 ")" 
			->("if (pflag) {" .LM+ .NL)
			->("if (tflag) __SCOPE__.__MATCH__ += inbuf.charAt(__SCOPE__.__CURSOR__) ;" .NL)
			->("__SCOPE__.__CURSOR__++ } ;" .LM- .NL)
		| ID                 
			->("ctxpush(" 34 * 34 ") ;" .NL)
			->("rule" * "() ;" .NL)
			->("ctxpop() ;" .NL)
			->("if (eflag) return ;" .NL)
		| "[" $(CX1) "]"
		| "(" TX1 ")";

// -------------------------- Character expressions ----------------------------
rule CX1 = ->("pflag = " .LM+ .NL)
      CX2 $("!" ->(" ||" .NL) CX2)
      ->(.LM- " ;" .NL) ;
rule CX2 = CX3 (":" ->("((inbuf.charCodeAt(__SCOPE__.__CURSOR__) >= " * ") &&" .NL)
				CX3
					->(" (inbuf.charCodeAt(__SCOPE__.__CURSOR__) <= " * ")  )" )
				| .EMPTY ->("(inbuf.charCodeAt(__SCOPE__.__CURSOR__) == " * ") " ));
rule CX3 = NUMBER | SQUOTE .LITCHR ;

token PREFIX = $.ANY(32!9!13!10);
token ID     = PREFIX .TOKEN ALPHA $(ALPHA/DIGIT) .DELTOK;
token NUMBER = PREFIX .TOKEN $.ANY('-) DIGIT $DIGIT .DELTOK;
token STRING = PREFIX .ANY(34) .TOKEN $.ANYBUT(13!10!34) .DELTOK .ANY(34);
token RAWSTRING = PREFIX .TOKEN .ANY(34) $.ANYBUT(13!10!34) .ANY(34) .DELTOK;
token ALPHA  = .ANY('A:'Z!'a:'z!'_);
token DIGIT  = .ANY('0:'9);
token SQUOTE = PREFIX .ANY('');
token CMLINE = .TOKEN $.ANYBUT(10!13) .DELTOK;
