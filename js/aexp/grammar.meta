.SYNTAX AEXP

AEXP = AS $AS;

AS = @Identifier(ID ->(*)) @@ "=" EX1 ";" :VariableDeclaration<id = @Identifier>[1];

EX1 = EX2 $("+" EX2 :BinaryExpression<operator = "+">[2] |
            "-" EX2 :BinaryExpression<operator = "-">[2] );

EX2 = EX3 $("*" EX3 :BinaryExpression<operator = "*">[2] |
            "/" EX3 :BinaryExpression<operator = "/">[2] );

EX3 = EX4 $("^" EX3 :BinaryExpression<operator = "^">[2]);

EX4 = "+" :UnaryExpression<operator = "+">[1] EX5
		| "-" EX5 :UnaryExpression<operator = "-">[1]
		| EX5;

EX5 = ID ::Identifier
		| NUMBER ::Literal
		| "(" EX1 ")";

.TOKENS

PREFIX : $.ANY(32!9!13!10);
ID     : PREFIX .TOKEN ALPHA $(ALPHA/DIGIT) .DELTOK;
NUMBER : PREFIX .TOKEN $.ANY('-) DIGIT $DIGIT .DELTOK;
ALPHA  : .ANY('A:'Z!'a:'z!'_);
DIGIT  : .ANY('0:'9);

.END
