// ignore_rule = "ignore" _ tx1 _? ";";

token _ = [ \t]+;
token id = alpha (alpha | digit)*;
token number = [\-]+ digit+;
token string = ["][^\n\r"]["];
token multiline_string = [`][^`][`];
token alpha = [A-Za-z_$];
token digit = [0-9];
token squote = ['];
token cmline = [^\n\r];